# fastlane/Fastfile
require "shellwords"

default_platform(:ios)

platform :ios do
  APP_SCHEME  = "SpaceWalker"
  XCODEPROJ   = "SpaceWalker.xcodeproj"
  BUILD_DIR   = "build"
  IPA_NAME    = "SpaceWalker.ipa"
  BUNDLE_ID   = "com.andev.SpaceWalker"

  CI_KEYCHAIN_NAME = "ci"

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  private_lane :set_timestamp_build_number do
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )
  end

  private_lane :setup_ci_keychain do
    create_keychain(
      name: CI_KEYCHAIN_NAME,
      password: ENV.fetch("KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    raw_keychain_path = Actions.lane_context[Actions::SharedValues::KEYCHAIN_PATH].to_s
    expanded_keychain_path = File.expand_path(raw_keychain_path)
    keychain_path = if File.exist?(expanded_keychain_path)
                      expanded_keychain_path
                    elsif File.exist?("#{expanded_keychain_path}-db")
                      "#{expanded_keychain_path}-db"
                    else
                      expanded_keychain_path
                    end

    escaped_keychain_path = Shellwords.escape(keychain_path)
    escaped_login_path = Shellwords.escape(File.expand_path("~/Library/Keychains/login.keychain-db"))
    escaped_password = Shellwords.escape(ENV.fetch("KEYCHAIN_PASSWORD"))

    sh("security list-keychains -d user -s #{escaped_keychain_path} #{escaped_login_path}")
    sh("security set-keychain-settings -lut 3600 #{escaped_keychain_path}")
    sh("security unlock-keychain -p #{escaped_password} #{escaped_keychain_path}")
  end

  private_lane :sync_signing do
    options = {
      type: "appstore",
      readonly: true,
      app_identifier: [BUNDLE_ID]
    }

    if ENV["CI"]
      options[:keychain_name] = CI_KEYCHAIN_NAME
      options[:keychain_password] = ENV.fetch("KEYCHAIN_PASSWORD")
    end

    match(**options)
  end

  lane :beta do
    asc_api_key
    set_timestamp_build_number

    setup_ci_keychain if ENV["CI"]
    sync_signing

    build_app(
      scheme: APP_SCHEME,
      clean: true,
      output_directory: BUILD_DIR,
      output_name: IPA_NAME,
      export_method: "app-store"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
