# fastlane/Fastfile

default_platform(:ios)

platform :ios do
  # -----------------------------
  # Config
  # -----------------------------
  APP_SCHEME  = "SpaceWalker"
  XCODEPROJ   = "SpaceWalker.xcodeproj"
  BUILD_DIR   = "build"
  IPA_NAME    = "SpaceWalker.ipa"
  BUNDLE_ID   = "com.andev.SpaceWalker"

  # CI keychain
  CI_KEYCHAIN_NAME = "ci"

  # -----------------------------
  # Private lanes
  # -----------------------------
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  private_lane :set_timestamp_build_number do
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )
  end

  # CI에서만 키체인 세팅
  private_lane :setup_ci_keychain do
    create_keychain(
      name: CI_KEYCHAIN_NAME,
      password: ENV.fetch("KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # create_keychain 이후, fastlane이 잡아준 실제 경로 사용
    keychain_path = Actions.lane_context[Actions::SharedValues::KEYCHAIN_PATH]

    sh("security set-keychain-settings -lut 3600 '#{keychain_path}'")
    sh("security unlock-keychain -p '#{ENV.fetch("KEYCHAIN_PASSWORD")}' '#{keychain_path}'")
  end

  private_lane :sync_signing do
    options = {
      type: "appstore",
      readonly: true,
      app_identifier: [BUNDLE_ID]
    }

    if ENV["CI"]
      options[:keychain_name] = CI_KEYCHAIN_NAME
      options[:keychain_password] = ENV.fetch("KEYCHAIN_PASSWORD")
    end

    match(**options)
  end

  # -----------------------------
  # Public lanes
  # -----------------------------
  desc "CI용 빌드/아카이브"
  lane :build_ci do
    build_app(
      scheme: APP_SCHEME,
      clean: true,
      output_directory: BUILD_DIR,
      output_name: IPA_NAME,
      export_method: "app-store"
    )
  end

  desc "TestFlight Upload"
  lane :beta do
    asc_api_key
    set_timestamp_build_number

    setup_ci_keychain if ENV["CI"]
    sync_signing

    build_app(
      scheme: APP_SCHEME,
      clean: true,
      output_directory: BUILD_DIR,
      output_name: IPA_NAME,
      export_method: "app-store"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end