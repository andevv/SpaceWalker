### Xcode ###
# Ignore user-specific settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Derived data & build artifacts
build/
Build/
DerivedData/
*.moved-aside

# Legacy Xcode versions
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Others
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Xcode project internals - exclude user-specific data only
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

### Swift Package Manager ###
# Keep lock files (must be committed)
!Package.resolved
!**/swiftpm/Package.resolved

# Ignore caches/build artifacts
.swiftpm/
.build/
Packages/
Package.pins
SourcePackages/

